# VYNE platform — environment template (no secrets in source, EA-001)
# Copy to .env.local per app / .env for tooling. Real values never enter the repo.

# Local Supabase (values printed by `supabase start`; these are the CLI's
# well-known local defaults, not secrets for any hosted service)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key

# Direct Postgres connection for migrations / SQL tests (local only)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Cooling-rule policy (M4): configurable, default ON per DL-2026-006(c) / CR-001 §1.4
COOLING_RULE_ENABLED=true
